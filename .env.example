# Copy to .env for local use. No real secrets belong in this file.
# Empty values are treated as unset.

NODE_ENV=development
HOST=0.0.0.0
# 4001 is the port the API Gateway expects for the Identity Service.
PORT=4001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. Local-only credentials matching docker-compose.yml.
DATABASE_URL=postgres://identity:identity@localhost:5432/identity

# Required, at least 32 bytes (HS256). Generate one with: openssl rand -base64 48
# The service refuses to start while this is empty.
JWT_SECRET=
JWT_ISSUER=cloud-platform-gov-identity
# Access-token lifetime: <n>s | <n>m | <n>h | <n>d
JWT_ACCESS_TOKEN_TTL=15m

# Comma-separated exact origins allowed by CORS (e.g. http://localhost:5173).
# Empty means no cross-origin browser access.
CORS_ORIGIN=

# Tests only (`npm test`). Must point at a database whose name ends in _test.
# Started by `npm run test:db:up`.
TEST_DATABASE_URL=postgres://identity:identity@localhost:5433/identity_test
